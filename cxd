-- 检测 HTTP 函数
local httpRequestFn = nil
local httpFnName    = "无"
if syn and syn.request then
    httpRequestFn = syn.request; httpFnName = "syn.request"
elseif http and http.request then
    httpRequestFn = http.request; httpFnName = "http.request"
elseif request then
    httpRequestFn = request; httpFnName = "request"
elseif http_request then
    httpRequestFn = http_request; httpFnName = "http_request"
elseif fluxus and fluxus.request then
    httpRequestFn = fluxus.request; httpFnName = "fluxus.request"
end
print("★ [Sigma Hub] HTTP 支持：" .. httpFnName)

local aiChatHistory = {}

local function buildAIRequestBody(userMessage)
    local messages = {}
    table.insert(messages, { role = "system", content = AI_CONFIG.SYSTEM_PROMPT })
    for _, msg in ipairs(aiChatHistory) do
        table.insert(messages, msg)
    end
    table.insert(messages, { role = "user", content = userMessage })
    return {
        model       = AI_CONFIG.MODEL,
        messages    = messages,
        temperature = 0.7,
        max_tokens  = 500,
    }
end

local function callAI(userMessage)
    if not httpRequestFn then
        return nil, "当前执行器不支持 HTTP 请求"
    end
    if not AI_CONFIG.API_KEY or AI_CONFIG.API_KEY == ""
    or AI_CONFIG.API_KEY == "在这里填入你的API-Key" then
        return nil, "未配置 API Key（请在脚本顶部 AI_CONFIG 里填写）"
    end

    local body = buildAIRequestBody(userMessage)
    local jsonBody
    local okEncode, encodeErr = pcall(function()
        jsonBody = HttpService:JSONEncode(body)
    end)
    if not okEncode then
        return nil, "请求体编码失败：" .. tostring(encodeErr)
    end

    local okReq, response = pcall(function()
        return httpRequestFn({
            Url     = AI_CONFIG.API_URL,
            Method  = "POST",
            Headers = {
                ["Content-Type"]  = "application/json",
                ["Authorization"] = "Bearer " .. AI_CONFIG.API_KEY,
            },
            Body = jsonBody,
        })
    end)

    if not okReq then
        return nil, "请求发送失败：" .. tostring(response)
    end
    if not response then
        return nil, "服务器无响应"
    end
    if not response.Body or response.Body == "" then
        return nil, "响应为空（状态码 " .. tostring(response.StatusCode) .. "）"
    end

    local okDecode, data = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)
    if not okDecode then
        return nil, "响应解析失败：" .. tostring(data)
    end

    if data.choices and data.choices[1]
    and data.choices[1].message
    and data.choices[1].message.content then
        local reply = data.choices[1].message.content
        table.insert(aiChatHistory, { role = "user",      content = userMessage })
        table.insert(aiChatHistory, { role = "assistant", content = reply })
        while #aiChatHistory > AI_CONFIG.MAX_HISTORY * 2 do
            table.remove(aiChatHistory, 1)
        end
        return reply
    end

    if data.error and data.error.message then
        return nil, "API 错误：" .. data.error.message
    end

    return nil, "未知响应格式（状态码 " .. tostring(response.StatusCode) .. "）"
end

-- 对外入口：本地指令优先，其他走 API，失败回退本地
local function aiRespond(rawText)
    local localKeywords = {
        "帮助", "help", "指令", "清空", "clear", "状态", "status",
        "传送", "查玩家", "查npc", "查 npc", "npc列表",
        "开技能", "关技能", "开卖鱼", "关卖鱼", "开鱼条", "关鱼条",
        "现在卖鱼", "立即卖鱼", "开esp", "关esp",
    }
    local lower = string.lower(rawText)
    for _, kw in ipairs(localKeywords) do
        if string.find(lower, string.lower(kw), 1, true) then
            return aiRespondLocal(rawText)
        end
    end

    local reply, err = callAI(rawText)
    if reply then return reply end

    if AI_CONFIG.FALLBACK_TO_LOCAL then
        local fallback = aiRespondLocal(rawText)
        return fallback .. "\n\n（AI 暂不可用：" .. (err or "未知错误") .. "，已回退本地模式）"
    end
    return "AI 服务暂时不可用：" .. (err or "未知错误")
end

