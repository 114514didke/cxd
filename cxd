local function getFishingUI()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return nil end
    return (pg:FindFirstChild("MainGui") and pg.MainGui:FindFirstChild("Fishing"))
        or pg:FindFirstChild("Fishing")
        or pg:FindFirstChild("FishingUI")
        or pg:FindFirstChild("FishingGui")
        or pg:FindFirstChild("FishingScreen")
end

local function getFishingBarFrame()
    local ui = getFishingUI()
    if not ui or not ui.Visible then return nil end
    local barFrame = ui:FindFirstChild("FishingBar")
        or ui:FindFirstChild("BarFrame")
        or ui:FindFirstChild("Bar")
        or ui:FindFirstChild("ProgressBar")
    if barFrame and barFrame.Visible then return barFrame end
    return nil
end

local function fireFishing(arg)
    local target
    local events = ReplicatedStorage:FindFirstChild("Events")
    if events then target = events:FindFirstChild("Fishing") end
    if not target then target = ReplicatedStorage:FindFirstChild("Fishing") end
    if not target then return false end
    return pcall(function()
        if arg ~= nil then target:FireServer(arg) else target:FireServer() end
    end)
end

