local function newTpButton(parent, y, label, color, onTp)
    local btn = Instance.new("TextButton")
    btn.Size                   = UDim2.new(0.95, 0, 0, 30)
    btn.Position               = UDim2.new(0.025, 0, 0, y)
    btn.BackgroundColor3       = color
    btn.TextColor3             = Color3.new(1, 1, 1)
    btn.Font                   = Enum.Font.GothamBold
    btn.TextSize               = 11
    btn.Text                   = label
    btn.TextTruncate           = Enum.TextTruncate.AtEnd
    btn.TextXAlignment         = Enum.TextXAlignment.Left
    btn.AutoButtonColor        = false
    btn.ClipsDescendants       = true
    btn.Parent                 = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    local st = Instance.new("UIStroke", btn)
    st.Color        = Color3.fromRGB(80, 90, 110)
    st.Thickness    = 1
    st.Transparency = 0.5

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.12), {
            BackgroundColor3 = Color3.fromRGB(
                math.min(color.R * 255 + 25, 255) / 255,
                math.min(color.G * 255 + 25, 255) / 255,
                math.min(color.B * 255 + 25, 255) / 255
            ),
        }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = color }):Play()
    end)

    btn.MouseButton1Click:Connect(function()
        pcall(function() sTp:Play() end)
        if onTp then pcall(onTp) end
        btn.TextColor3 = Color3.fromRGB(255, 240, 120)
        task.delay(0.35, function()
            if btn.Parent then btn.TextColor3 = Color3.new(1, 1, 1) end
        end)
    end)
    return btn
end

local function refreshTeleportList()
    for _, b in ipairs(tpPlayerBtns) do if b.Parent then b:Destroy() end end
    for _, b in ipairs(tpNpcBtns) do if b.Parent then b:Destroy() end end
    tpPlayerBtns = {}
    tpNpcBtns    = {}

    -- 玩家
    local playerList = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                table.insert(playerList, { name = plr.Name, model = plr.Character })
            end
        end
    end
    table.sort(playerList, function(a, b) return a.name < b.name end)

    -- NPC（智能过滤 + 归一化去重）
    local npcRaw = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and isEligibleNpc(obj) then
            table.insert(npcRaw, obj)
        end
    end
    local npcList = dedupeNpcsByName(npcRaw)
    table.sort(npcList, function(a, b) return a.Name < b.Name end)

    local y = 5

    if tpHeaderPlayer and tpHeaderPlayer.Parent then tpHeaderPlayer:Destroy() end
    tpHeaderPlayer = Instance.new("TextLabel")
    tpHeaderPlayer.Size                   = UDim2.new(0.95, 0, 0, 22)
    tpHeaderPlayer.Position               = UDim2.new(0.025, 0, 0, y)
    tpHeaderPlayer.BackgroundColor3       = Color3.fromRGB(30, 40, 60)
    tpHeaderPlayer.TextColor3             = CurrentTheme.accent
    tpHeaderPlayer.Font                   = Enum.Font.GothamBold
    tpHeaderPlayer.TextSize               = 11
    tpHeaderPlayer.TextXAlignment         = Enum.TextXAlignment.Left
    tpHeaderPlayer.Text                   = "  🎯  玩家 (" .. #playerList .. ")"
    tpHeaderPlayer.Parent                 = pageTp
    Instance.new("UICorner", tpHeaderPlayer).CornerRadius = UDim.new(0, 6)
    y = y + 28

    if #playerList == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size                   = UDim2.new(0.95, 0, 0, 26)
        empty.Position               = UDim2.new(0.025, 0, 0, y)
        empty.BackgroundColor3       = Color3.fromRGB(22, 26, 38)
        empty.TextColor3             = Color3.fromRGB(150, 160, 180)
        empty.Font                   = Enum.Font.Gotham
        empty.TextSize               = 10
        empty.Text                   = "  暂无其他玩家"
        empty.Parent                 = pageTp
        Instance.new("UICorner", empty).CornerRadius = UDim.new(0, 6)
        table.insert(tpPlayerBtns, empty)
        y = y + 32
    else
        for _, entry in ipairs(playerList) do
            local plrModel = entry.model
            local btn = newTpButton(
                pageTp, y, "  🎯  " .. entry.name,
                Color3.fromRGB(0, 100, 190),
                function()
                    if not plrModel.Parent then return end
                    local hrp = plrModel:FindFirstChild("HumanoidRootPart")
                    if hrp then teleportToHrp(hrp) end
                end
            )
            table.insert(tpPlayerBtns, btn)
            y = y + 34
        end
    end

    y = y + 8

    if tpHeaderNpc and tpHeaderNpc.Parent then tpHeaderNpc:Destroy() end
    tpHeaderNpc = Instance.new("TextLabel")
    tpHeaderNpc.Size                   = UDim2.new(0.95, 0, 0, 22)
    tpHeaderNpc.Position               = UDim2.new(0.025, 0, 0, y)
    tpHeaderNpc.BackgroundColor3       = Color3.fromRGB(30, 40, 60)
    tpHeaderNpc.TextColor3             = CurrentTheme.accent
    tpHeaderNpc.Font                   = Enum.Font.GothamBold
    tpHeaderNpc.TextSize               = 11
    tpHeaderNpc.TextXAlignment         = Enum.TextXAlignment.Left
    local npcHeaderSuffix = ""
    if CFG.FilterQuestNpcs then npcHeaderSuffix = npcHeaderSuffix .. " · 任务/刷新" end
    if CFG.DedupeNpcs then      npcHeaderSuffix = npcHeaderSuffix .. " · 已去重"   end
    tpHeaderNpc.Text                   = "  📍  NPC" .. npcHeaderSuffix .. " (" .. #npcList .. ")"
    tpHeaderNpc.Parent                 = pageTp
    Instance.new("UICorner", tpHeaderNpc).CornerRadius = UDim.new(0, 6)
    y = y + 28

    if #npcList == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size                   = UDim2.new(0.95, 0, 0, 26)
        empty.Position               = UDim2.new(0.025, 0, 0, y)
        empty.BackgroundColor3       = Color3.fromRGB(22, 26, 38)
        empty.TextColor3             = Color3.fromRGB(150, 160, 180)
        empty.Font                   = Enum.Font.Gotham
        empty.TextSize               = 10
        empty.Text                   = CFG.FilterQuestNpcs
            and "  暂未发现任务/刷新 NPC"
            or  "  暂未发现 NPC"
        empty.Parent                 = pageTp
        Instance.new("UICorner", empty).CornerRadius = UDim.new(0, 6)
        table.insert(tpNpcBtns, empty)
        y = y + 32
    else
        for _, npcModel in ipairs(npcList) do
            local btn = newTpButton(
                pageTp, y, "  📍  " .. npcModel.Name,
                Color3.fromRGB(0, 130, 100),
                function()
                    if not npcModel.Parent then return end
                    local hrp = npcModel:FindFirstChild("HumanoidRootPart")
                    if hrp then teleportToHrp(hrp) end
                end
            )
            table.insert(tpNpcBtns, btn)
            y = y + 34
        end
    end

    pageTp.CanvasSize = UDim2.new(0, 0, 0, y + 12)
end

