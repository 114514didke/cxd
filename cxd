local function getFishUI()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return nil end
    return (pg:FindFirstChild("MainGui") and pg.MainGui:FindFirstChild("Fishing"))
        or pg:FindFirstChild("Fishing") or pg:FindFirstChild("FishingUI")
        or pg:FindFirstChild("FishingGui") or pg:FindFirstChild("FishingScreen")
end

local function getBarFrame()
    local ui = getFishUI()
    if not ui or not ui.Visible then return nil end
    local bf = ui:FindFirstChild("FishingBar") or ui:FindFirstChild("BarFrame")
        or ui:FindFirstChild("Bar") or ui:FindFirstChild("ProgressBar")
    if bf and bf.Visible then return bf end
    return nil
end

local function fireFishing(arg)
    local t
    local ev = RS:FindFirstChild("Events")
    if ev then t = ev:FindFirstChild("Fishing") end
    if not t then t = RS:FindFirstChild("Fishing") end
    if not t then return false end
    return pcall(function()
        if arg ~= nil then t:FireServer(arg) else t:FireServer() end
    end)
end

