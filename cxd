local activePage, activeIdx = nil, nil
local switchTween = TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

local function selectTab(id)
    pcall(function() sClick:Play() end)
    for i, b in ipairs(navBtns) do
        local on = (b.id == id)
        if on then activeIdx = i end
        Tween:Create(b.circle, switchTween, {
            BackgroundColor3 = on and T.a or T.bg,
            TextColor3 = on and Color3.new(1,1,1) or TXT_DIM,
            Size = on and UDim2.new(0, 46, 0, 46) or UDim2.new(0, 42, 0, 42),
            Position = on and UDim2.new(0, 6, 0, 2) or UDim2.new(0, 8, 0, 4),
        }):Play()
        Tween:Create(b.stroke, switchTween, {
            Color = on and T.a or TXT_MUTED,
            Transparency = on and 0 or 0.5,
            Thickness = on and 2 or 1.5,
        }):Play()
        Tween:Create(b.label, switchTween, {
            TextColor3 = on and T.a or TXT_MUTED,
        }):Play()
    end
    if activePage and activePage ~= pages[id] then
        activePage.Visible = false
    end
    pages[id].Visible = true
    activePage = pages[id]
end

for id, btn in pairs(navRefs) do
