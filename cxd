        local myToken = FunState.React.token
        area.BackgroundColor3 = Color3.fromRGB(160, 40, 60)
        area.Text             = "等待变绿…"
        task.spawn(function()
            task.wait(1 + math.random() * 3)
            if FunState.React.token ~= myToken then return end
            if FunState.React.mode ~= "waiting" then return end
            FunState.React.mode    = "ready"
            FunState.React.readyAt = tick()
            area.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
            area.Text             = "点！"
        end)
    end

    area.MouseButton1Click:Connect(function()
        pcall(function() sClick:Play() end)
        local mode = FunState.React.mode
        if mode == "idle" then
            startWait()
