    lbl.Parent = row

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 60, 0, 30)
    box.Position = UDim2.new(1, -132, 0.5, -15)
    box.BackgroundColor3 = T.bg
    box.TextColor3 = T.a
    box.Font = Enum.Font.GothamBold
    box.TextSize = 13
    box.Text = tostring(defaultVal)
    box.ClearTextOnFocus = false
    box.BorderSizePixel = 0
    box.Parent = row
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)
    local bS = Instance.new("UIStroke", box)
    bS.Color = T.a; bS.Thickness = 1; bS.Transparency = 0.5

    local okBtn = Instance.new("TextButton")
    okBtn.Size = UDim2.new(0, 60, 0, 30)
    okBtn.Position = UDim2.new(1, -64, 0.5, -15)
    okBtn.BackgroundColor3 = T.a
    okBtn.Text = "OK"
    okBtn.TextColor3 = Color3.new(1,1,1)
    okBtn.Font = Enum.Font.GothamBold
    okBtn.TextSize = 11
    okBtn.AutoButtonColor = false
    okBtn.BorderSizePixel = 0
    okBtn.Parent = row
    Instance.new("UICorner", okBtn).CornerRadius = UDim.new(0, 8)

    local function submit()
        local n = tonumber(box.Text)
        if n and n >= minV and n <= maxV then
            applyFn(n)
            box.Text = tostring(n)
            okBtn.Text = "✓"
            task.delay(0.8, function() okBtn.Text = "OK" end)
        else
            box.Text = tostring(defaultVal)
            okBtn.Text = "✕"
            okBtn.BackgroundColor3 = Color3.fromRGB(255,80,80)
            task.delay(0.8, function()
                okBtn.Text = "OK"
                okBtn.BackgroundColor3 = T.a
            end)
        end
    end

    okBtn.MouseButton1Click:Connect(function()
        pcall(function() sClick:Play() end)
        submit()
    end)
    box.FocusLost:Connect(function() submit() end)

    return {
        row = row, lbl = lbl, box = box,
        stroke = rS, boxStroke = bS, btn = okBtn,
    }
end

