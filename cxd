local function lc(x) return type(x)=="string" and string.lower(x) or "" end
local function hasKw(t, kws)
    local s = lc(t); if s=="" then return false end
    for _, k in ipairs(kws) do if string.find(s, lc(k), 1, true) then return true end end
    return false
end
local function normNpc(n)
    if type(n)~="string" then return "" end
    local x = string.lower(n)
    if C.ALIASES[x] then return C.ALIASES[x] end
    x = x:gsub("%s*%b()%s*$",""):gsub("[%s_%-]%d+$",""):gsub("[%s_%-%.%:]+",""):gsub("%d+$","")
    if C.ALIASES[x] then return C.ALIASES[x] end
    return x
end
local function isQuestNpc(m)
    if not m or not m.Parent then return false end
    local ok, tags = pcall(function() return CS:GetTags(m) end)
    if ok and tags then
        for _, t in ipairs(tags) do
            local tl = lc(t)
            for _, k in ipairs(C.NPC_TAGS) do
                if tl==lc(k) or string.find(tl, lc(k), 1, true) then return true end
            end
        end
    end
    if hasKw(m.Name, C.NPC_KEYWORDS) then return true end
    for _, a in ipairs(C.NPC_ATTRS) do
        local ok2, v = pcall(function() return m:GetAttribute(a) end)
        if ok2 and v~=nil then return true end
    end
    for _, ch in ipairs(m:GetDescendants()) do
        if ch:IsA("ProximityPrompt") or ch:IsA("ClickDetector")
        or ch:IsA("Dialog") or ch:IsA("DialogChoice") then return true end
        if hasKw(ch.Name, C.NPC_KEYWORDS) then return true end
        for _, a in ipairs(C.NPC_ATTRS) do
            local ok3, v = pcall(function() return ch:GetAttribute(a) end)
            if ok3 and v~=nil then return true end
        end
    end
    return false
end
local function isOkNpc(m)
    if not m or not m.Parent then return false end
    if Players:GetPlayerFromCharacter(m) then return false end
    local h = m:FindFirstChildOfClass("Humanoid")
    local r = m:FindFirstChild("HumanoidRootPart")
    if not h or not r or h.Health<=0 then return false end
    if C.FilterQuestNpcs then return isQuestNpc(m) end
    return true
end
local function dedupe(list)
    if not C.DedupeNpcs then return list end
    local pos = Vector3.new(0,0,0)
    if LP.Character then
        local h = LP.Character:FindFirstChild("HumanoidRootPart")
        if h then pos = h.Position end
    end
    local by = {}
    for _, n in ipairs(list) do
        local r = n:FindFirstChild("HumanoidRootPart")
        if r then
            local d = (r.Position - pos).Magnitude
            local k = normNpc(n.Name)
            if not by[k] or d < by[k].d then by[k] = { n=n, d=d } end
        end
    end
    local out = {}
    for _, e in pairs(by) do table.insert(out, e.n) end
    return out
end

