local function aiRespondLocal(rawText)
    local t = string.lower(rawText)

    if contains(t, "帮助") or contains(t, "help") or contains(t, "怎么用")
    or contains(t, "指令") or contains(t, "命令") then
        return "我是 Sigma Hub 内置助手，可以帮你做这些事：\n" ..
               "• 开/关 技能、自动卖鱼、锁定鱼条、ESP\n" ..
               "• 查状态（显示所有开关当前状态）\n" ..
               "• 传送 <玩家名>（传送到指定玩家）\n" ..
               "• 查玩家 / 查NPC（列出当前列表）\n" ..
               "• 时间（显示当前时间）\n" ..
               "• 清空（清空聊天记录）"
    end

    if contains(t, "清空") or contains(t, "清除聊天") or contains(t, "clear") then
        for _, child in ipairs(chatScroll:GetChildren()) do
            if child:IsA("Frame") then child:Destroy() end
        end
        return "聊天记录已清空。"
    end

    if contains(t, "你好") or contains(t, "hello") or contains(t, "hi")
    or contains(t, "嗨") or contains(t, "在吗") then
        return "你好！我是 Sigma Hub 助手，随时可以帮你操作面板。试试说「帮助」看看我能干什么。"
    end

    if contains(t, "你叫什么") or contains(t, "你是谁") or contains(t, "your name") then
        return "我是 Sigma Hub 内置助手，一个纯本地运行的规则机器人。如果配置了 API，还能接入真正的 AI。"
    end

    if contains(t, "时间") or contains(t, "time") or contains(t, "几点") then
        local ok, str = pcall(function()
            return DateTime.now():FormatLocalTime("YYYY-MM-DD HH:mm:ss", "zh-cn")
        end)
        if ok and str then return "当前时间：" .. str end
        return "当前时间戳：" .. tostring(os.time())
    end

    if contains(t, "状态") or contains(t, "status") or contains(t, "开关") then
        return string.format(
            "当前状态：\n• 自动技能：%s\n• 自动卖鱼：%s\n• 锁定鱼条：%s\n• 玩家 ESP：%s\n• NPC ESP：%s\n• 卖出间隔：%s 秒",
            State.AutoSkill and "开" or "关",
            State.AutoSell  and "开" or "关",
            State.BarLock   and "开" or "关",
            State.PlayerESP and "开" or "关",
            State.NpcESP    and "开" or "关",
            tostring(CFG.SELL_INTERVAL)
        )
    end

    if contains(t, "传送") or contains(t, "tp ") or contains(t, "传 ") then
        local targetName = rawText:match("[传送tp ]+([%w_]+)")
        if not targetName or targetName == "" then
            return "用法：传送 <玩家名>，例如「传送 Builderman」"
        end
        local target = nil
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and string.lower(plr.Name) == string.lower(targetName) then
                target = plr
                break
            end
        end
        if not target then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LP and string.find(string.lower(plr.Name), string.lower(targetName), 1, true) then
                    target = plr
                    break
                end
            end
        end
        if not target or not target.Character then
            return "找不到玩家「" .. targetName .. "」。"
        end
        local hrp = target.Character:FindFirstChild("HumanoidRootPart")
        local myChar = LP.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if hrp and myHrp then
            myHrp.CFrame = hrp.CFrame * CFrame.new(0, 0, -CFG.TP_OFFSET)
            return "已传送到玩家 " .. target.Name
        end
        return "传送失败，目标还没有角色。"
    end

    if contains(t, "查玩家") or contains(t, "玩家列表") or contains(t, "player list") then
        local list = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP then table.insert(list, plr.Name) end
        end
        if #list == 0 then return "当前没有其他玩家。" end
        return "当前服务器玩家：" .. table.concat(list, "、")
    end

    if contains(t, "查npc") or contains(t, "查 npc") or contains(t, "npc列表") then
        local list, seen = {}, {}
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and isEligibleNpc(obj) then
                local key = normalizeNpcName(obj.Name)
                if not seen[key] then
                    seen[key] = true
                    table.insert(list, obj.Name)
                end
            end
        end
        if #list == 0 then return "当前没有符合条件的 NPC。" end
        if #list > 20 then
            return "当前有 " .. #list .. " 个符合条件的 NPC（只列出前 20 个）：\n" ..
                table.concat({unpack(list, 1, 20)}, "、")
        end
        return "当前符合条件的 NPC：" .. table.concat(list, "、")
    end

    if contains(t, "技能") or contains(t, "skill") then
        if contains(t, "关") or contains(t, "off") or contains(t, "停") then
            setToggleState("AutoSkill", false)
            return "已关闭自动全技能。"
        elseif contains(t, "开") or contains(t, "on") or contains(t, "启") then
            setToggleState("AutoSkill", true)
            return "已开启自动全技能。"
        end
        return "自动全技能当前：" .. (State.AutoSkill and "开启" or "关闭")
    end

    if contains(t, "卖鱼") or contains(t, "sell") then
        if contains(t, "关") or contains(t, "off") then
            setToggleState("AutoSell", false)
            return "已关闭自动卖鱼。"
        elseif contains(t, "开") or contains(t, "on") then
            setToggleState("AutoSell", true)
            return "已开启自动卖鱼，间隔 " .. tostring(CFG.SELL_INTERVAL) .. " 秒。"
        elseif contains(t, "现在") or contains(t, "立即") or contains(t, "马上") then
            pcall(function()
                local events = ReplicatedStorage:FindFirstChild("Events")
                if events then
                    local sell = events:FindFirstChild("SellFish")
                    if sell then sell:FireServer("All") return end
                end
                local sell = ReplicatedStorage:FindFirstChild("SellFish")
                if sell then sell:FireServer("All") end
            end)
            return "已立即卖出所有鱼。"
        end
        return "自动卖鱼当前：" .. (State.AutoSell and "开启" or "关闭")
    end

    if contains(t, "鱼条") or contains(t, "锁定") or contains(t, "bar") then
        if contains(t, "关") or contains(t, "off") then
            setToggleState("BarLock", false)
            return "已关闭鱼条锁定。"
        elseif contains(t, "开") or contains(t, "on") then
            setToggleState("BarLock", true)
            return "已开启鱼条锁定。"
        end
        return "鱼条锁定当前：" .. (State.BarLock and "开启" or "关闭")
    end

    if contains(t, "esp") then
        if contains(t, "关") or contains(t, "off") then
            setToggleState("PlayerESP", false)
            setToggleState("NpcESP", false)
            return "已关闭玩家和 NPC 的 ESP。"
        elseif contains(t, "玩家") and (contains(t, "开") or contains(t, "on")) then
            setToggleState("PlayerESP", true)
            return "已开启玩家 ESP。"
        elseif contains(t, "npc") and (contains(t, "开") or contains(t, "on")) then
            setToggleState("NpcESP", true)
            return "已开启 NPC ESP。"
        elseif contains(t, "开") or contains(t, "on") then
            setToggleState("PlayerESP", true)
            setToggleState("NpcESP", true)
            return "已开启玩家和 NPC 的 ESP。"
        end
        return string.format("ESP 状态：玩家 %s，NPC %s",
            State.PlayerESP and "开" or "关",
            State.NpcESP and "开" or "关")
    end

    return "抱歉，我还不太理解「" .. rawText .. "」。输入「帮助」可以看我会做的事情。"
end

