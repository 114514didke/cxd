local function selectTab(btn, page)
    activeTabBtn = btn
    pcall(function() sClick:Play() end)
    for _, b in ipairs(tabButtons) do
        if b == btn then
            TweenService:Create(b, tabTween, {
                BackgroundColor3 = CurrentTheme.accent,
                TextColor3       = Color3.new(1, 1, 1),
                Size             = UDim2.new(0.92, 0, 0, 30),
            }):Play()
        else
            TweenService:Create(b, tabTween, {
                BackgroundColor3 = Color3.fromRGB(22, 26, 38),
                TextColor3       = Color3.fromRGB(150, 160, 180),
                Size             = UDim2.new(0.86, 0, 0, 30),
            }):Play()
        end
    end
    if activePage and activePage ~= page then activePage.Visible = false end
    page.Visible = true
    activePage   = page
end

local themedToggles = {}

local function newToggle(parent, y, label, key, sfx)
    local btn = Instance.new("TextButton")
    btn.Size             = UDim2.new(0.95, 0, 0, 32)
    btn.Position         = UDim2.new(0.025, 0, 0, y)
    btn.BackgroundColor3 = Color3.fromRGB(26, 32, 46)
    btn.TextColor3       = Color3.fromRGB(200, 210, 230)
    btn.Font             = Enum.Font.GothamBold
    btn.TextSize         = 11
    btn.Text             = label .. "：关闭"
    btn.AutoButtonColor  = false
    btn.Parent           = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    local st = Instance.new("UIStroke", btn)
    st.Color, st.Thickness = Color3.fromRGB(50, 60, 80), 1

    btn.MouseButton1Click:Connect(function()
        if sfx then pcall(function() sfx:Play() end) end
        State[key] = not State[key]
        btn.Text = label .. "：" .. (State[key] and "开启" or "关闭")
        btn.BackgroundColor3 = State[key] and CurrentTheme.accent
                                          or Color3.fromRGB(26, 32, 46)
        btn.TextColor3       = State[key] and Color3.fromRGB(230, 255, 255)
                                          or Color3.fromRGB(200, 210, 230)
    end)
    table.insert(themedToggles, { btn = btn, key = key })
    return btn
end

