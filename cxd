local function loadDropAway(obj, delay, spin)
    task.delay(delay, function()
        if not obj or not obj.Parent then return end
        local goal = UDim2.new(
            obj.Position.X.Scale, obj.Position.X.Offset,
            obj.Position.Y.Scale, obj.Position.Y.Offset + DROP_DIST
        )
        local info = TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        local props = { Position = goal, Rotation = (obj.Rotation or 0) + spin }
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            props.TextTransparency = 1
        elseif obj:IsA("Frame") or obj:IsA("ImageLabel") then
            props.BackgroundTransparency = 1
        end
        TweenService:Create(obj, info, props):Play()
    end)
end

