local function applyTheme(theme)
    CurrentTheme.bg     = theme.bg
    CurrentTheme.accent = theme.accent

    TweenService:Create(panel, TweenInfo.new(0.25), { BackgroundColor3 = theme.bg }):Play()
    TweenService:Create(panelStroke, TweenInfo.new(0.25), { Color = theme.accent }):Play()
    TweenService:Create(titleLabel, TweenInfo.new(0.25), { TextColor3 = theme.accent }):Play()

    for _, b in ipairs(tabButtons) do
        if b == activeTabBtn then
            TweenService:Create(b, TweenInfo.new(0.25), { BackgroundColor3 = theme.accent }):Play()
        end
    end

    for _, item in ipairs(themedToggles) do
        if State[item.key] then
            TweenService:Create(item.btn, TweenInfo.new(0.25), { BackgroundColor3 = theme.accent }):Play()
        end
    end

    if intervalStroke then
        TweenService:Create(intervalStroke, TweenInfo.new(0.25), { Color = theme.accent }):Play()
    end

    for _, page in ipairs({pageSkill, pageFish, pageEsp, pageTp, pageTheme}) do
        page.ScrollBarImageColor3 = theme.accent
    end
end

