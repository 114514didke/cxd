    return {
        frame     = frame,
        name      = nameLabel,
        dist      = distLabel,
        highlight = highlight,
        kind      = kind,
    }
end

local function removeESPEntry(model)
    local entry = ESP.Entries[model]
    if not entry then return end
    if entry.frame and entry.frame.Parent then entry.frame:Destroy() end
    if entry.highlight and entry.highlight.Parent then entry.highlight:Destroy() end
    ESP.Entries[model] = nil
end

RunService.RenderStepped:Connect(function()
    local cam = workspace.CurrentCamera
    if not cam then return end

    local validModels = {}

    if State.PlayerESP then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP then
                local char = plr.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hum and hrp and hum.Health > 0 then
                        validModels[char] = { kind = "player", color = ESP.PlayerColor, name = plr.Name }
                    end
                end
            end
        end
    end

    if State.NpcESP then
        local now = tick()
        if now - ESP.LastNpcScan > 1 then
            local raw = {}
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and isEligibleNpc(obj) then
                    table.insert(raw, obj)
                end
            end
            ESP.NpcCache = dedupeNpcsByName(raw)
            ESP.LastNpcScan = now
        end
        for _, npc in ipairs(ESP.NpcCache) do
            if npc.Parent then
                local hum = npc:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    validModels[npc] = { kind = "npc", color = ESP.NpcColor, name = npc.Name }
                end
            end
        end
    end

    for model, entry in pairs(ESP.Entries) do
        if not validModels[model] then removeESPEntry(model) end
    end

    for model, info in pairs(validModels) do
        local entry = ESP.Entries[model]
        if not entry then
            entry = createESPEntry(model, info.color, info.kind)
            ESP.Entries[model] = entry
        end

        local hrp = model:FindFirstChild("HumanoidRootPart")
        if not hrp then
            entry.frame.Visible = false
            entry.highlight.Enabled = false
        else
            local pos3D = hrp.Position
            local screenPos, onScreen = cam:WorldToViewportPoint(pos3D)
            local distance = (cam.CFrame.Position - pos3D).Magnitude

            if not onScreen or screenPos.Z <= 0 or distance > ESP.MaxDistance then
                entry.frame.Visible = false
                entry.highlight.Enabled = false
            else
                entry.frame.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y)
                entry.frame.Visible = true
                entry.highlight.Enabled = true
                entry.name.Text = info.name
