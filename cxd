local function createESPEntry(model, color, kind)
    local frame = Instance.new("Frame")
    frame.BackgroundTransparency = 1
    frame.BorderSizePixel        = 0
    frame.Size                   = UDim2.new(0, 140, 0, 38)
    frame.AnchorPoint            = Vector2.new(0.5, 1)
    frame.Visible                = false
    frame.ZIndex                 = 2
    frame.Parent                 = espGui

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size                   = UDim2.new(1, 0, 0, 20)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3             = color
    nameLabel.Font                   = Enum.Font.GothamBold
    nameLabel.TextSize               = 13
    nameLabel.TextStrokeTransparency = 0.4
    nameLabel.TextStrokeColor3       = Color3.new(0, 0, 0)
    nameLabel.Text                   = model.Name
    nameLabel.ZIndex                 = 3
    nameLabel.Parent                 = frame

    local distLabel = Instance.new("TextLabel")
    distLabel.Size                   = UDim2.new(1, 0, 0, 16)
    distLabel.Position               = UDim2.new(0, 0, 0, 20)
    distLabel.BackgroundTransparency = 1
    distLabel.TextColor3             = color
    distLabel.Font                   = Enum.Font.GothamMedium
    distLabel.TextSize               = 11
    distLabel.TextStrokeTransparency = 0.4
    distLabel.TextStrokeColor3       = Color3.new(0, 0, 0)
    distLabel.Text                   = "0m"
    distLabel.ZIndex                 = 3
    distLabel.Parent                 = frame

    local highlight = Instance.new("Highlight")
    highlight.FillTransparency    = 1
    highlight.OutlineColor        = color
    highlight.OutlineTransparency = 0
    highlight.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee             = model
    highlight.Parent              = espGui

    return {
        frame     = frame,
        name      = nameLabel,
        dist      = distLabel,
        highlight = highlight,
        kind      = kind,
    }
end

local function removeESPEntry(model)
    local entry = ESP.Entries[model]
    if not entry then return end
    if entry.frame and entry.frame.Parent then entry.frame:Destroy() end
    if entry.highlight and entry.highlight.Parent then entry.highlight:Destroy() end
    ESP.Entries[model] = nil
end

RunService.RenderStepped:Connect(function()
    local cam = workspace.CurrentCamera
    if not cam then return end

    local validModels = {}

    if State.PlayerESP then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP then
                local char = plr.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hum and hrp and hum.Health > 0 then
                        validModels[char] = {
                            kind  = "player",
                            color = ESP.PlayerColor,
                            name  = plr.Name,
                        }
                    end
                end
            end
        end
    end

    if State.NpcESP then
        local now = tick()
        if now - ESP.LastNpcScan > 1 then
            local raw = {}
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and isEligibleNpc(obj) then
                    table.insert(raw, obj)
                end
            end
            ESP.NpcCache = dedupeNpcsByName(raw)
            ESP.LastNpcScan = now
        end
        for _, npc in ipairs(ESP.NpcCache) do
            if npc.Parent then
                local hum = npc:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    validModels[npc] = {
                        kind  = "npc",
                        color = ESP.NpcColor,
                        name  = npc.Name,
                    }
                end
            end
        end
    end

    for model, entry in pairs(ESP.Entries) do
        if not validModels[model] then
            removeESPEntry(model)
        end
    end

    for model, info in pairs(validModels) do
        local entry = ESP.Entries[model]
        if not entry then
            entry = createESPEntry(model, info.color, info.kind)
            ESP.Entries[model] = entry
        end

        local hrp = model:FindFirstChild("HumanoidRootPart")
        if not hrp then
            entry.frame.Visible = false
            entry.highlight.Enabled = false
        else
            local pos3D = hrp.Position
            local screenPos, onScreen = cam:WorldToViewportPoint(pos3D)
            local distance = (cam.CFrame.Position - pos3D).Magnitude

            if not onScreen or screenPos.Z <= 0 or distance > ESP.MaxDistance then
                entry.frame.Visible = false
                entry.highlight.Enabled = false
            else
                entry.frame.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y)
                entry.frame.Visible = true
                entry.highlight.Enabled = true
                entry.name.Text = info.name
                entry.dist.Text = string.format("%.0fm", distance)
            end
        end
    end
end)

