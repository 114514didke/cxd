    local ok = {}

    if S.PE then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP then
                local c = p.Character
                if c then
                    local h = c:FindFirstChildOfClass("Humanoid")
                    local r = c:FindFirstChild("HumanoidRootPart")
                    if h and r and h.Health > 0 then
                        ok[c] = { color = ESP.PC, name = p.Name }
                    end
                end
            end
        end
    end

    if S.NE then
        local now = tick()
        if now - ESP.LastScan > 1 then
            local raw = {}
            for _, o in ipairs(workspace:GetDescendants()) do
                if o:IsA("Model") and isOkNpc(o) then table.insert(raw, o) end
            end
            ESP.NpcCache = dedupe(raw)
            ESP.LastScan = now
        end
        for _, n in ipairs(ESP.NpcCache) do
            if n.Parent then
                local h = n:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 then
                    ok[n] = { color = ESP.NC, name = n.Name }
                end
            end
        end
    end

    for m in pairs(ESP.Entries) do
        if not ok[m] then killESP(m) end
    end

    for m, info in pairs(ok) do
        local e = ESP.Entries[m]
        if not e then
            e = makeESP(m, info.color)
            ESP.Entries[m] = e
        end
        local hrp = m:FindFirstChild("HumanoidRootPart")
        if not hrp then
            e.fr.Visible = false; e.hl.Enabled = false
        else
            local sp, on = cam:WorldToViewportPoint(hrp.Position)
            local d = (cam.CFrame.Position - hrp.Position).Magnitude
            if not on or sp.Z <= 0 or d > ESP.MaxD then
                e.fr.Visible = false; e.hl.Enabled = false
            else
                e.fr.Position = UDim2.new(0, sp.X, 0, sp.Y)
                e.fr.Visible = true; e.hl.Enabled = true
                e.nl.Text = info.name
                e.dl.Text = string.format("%.0fm", d)
            end
        end
    end
end)

