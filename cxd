        )
    end
    if contains(t,"传送") or contains(t,"tp ") then
        local target = raw:match("[传送tp ]+([%w_]+)")
        if not target or target == "" then return "用法：传送 <名字>" end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and string.find(string.lower(p.Name), string.lower(target), 1, true) then
                if p.Character then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    local my = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and my then
                        my.CFrame = hrp.CFrame * CFrame.new(0, 0, -C.TP_OFFSET)
                        return "✓ 已传送到 " .. p.Name
                    end
                end
            end
        end
        return "找不到 " .. target
    end
    if contains(t,"技能") then
        if contains(t,"关") then setToggleState("AS", false); return "技能 OFF" end
        if contains(t,"开") then setToggleState("AS", true);  return "技能 ON" end
