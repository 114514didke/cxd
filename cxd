local function lowerText(s)
    if type(s) ~= "string" then return "" end
    return string.lower(s)
end

local function containsKeyword(text, keywords)
    local t = lowerText(text)
    if t == "" then return false end
    for _, kw in ipairs(keywords) do
        if string.find(t, lowerText(kw), 1, true) then return true end
    end
    return false
end

local function normalizeNpcName(name)
    if type(name) ~= "string" then return "" end
    local n = string.lower(name)
    if CFG.NPC_NAME_ALIASES and CFG.NPC_NAME_ALIASES[n] then
        return CFG.NPC_NAME_ALIASES[n]
    end
    if CFG.AggressiveDedupe then
        n = n:gsub("%s*%b()%s*$", "")
        n = n:gsub("[%s_%-]%d+$", "")
        n = n:gsub("[%s_%-%.%:]+", "")
        n = n:gsub("%d+$", "")
        if CFG.NPC_NAME_ALIASES and CFG.NPC_NAME_ALIASES[n] then
            return CFG.NPC_NAME_ALIASES[n]
        end
    end
    return n
end

local function isQuestOrSpawnNpc(model)
    if not model or not model.Parent then return false end
    local ok, tags = pcall(function() return CollectionService:GetTags(model) end)
    if ok and tags then
        for _, tag in ipairs(tags) do
            local tl = lowerText(tag)
            for _, kw in ipairs(CFG.NPC_TAGS) do
                if tl == lowerText(kw) or string.find(tl, lowerText(kw), 1, true) then
                    return true
                end
            end
        end
    end
    if containsKeyword(model.Name, CFG.NPC_KEYWORDS) then return true end
    for _, attr in ipairs(CFG.NPC_ATTRS) do
        local ok2, val = pcall(function() return model:GetAttribute(attr) end)
        if ok2 and val ~= nil then return true end
    end
    for _, child in ipairs(model:GetDescendants()) do
        if child:IsA("ProximityPrompt") or child:IsA("ClickDetector")
        or child:IsA("Dialog") or child:IsA("DialogChoice") then
            return true
        end
        if containsKeyword(child.Name, CFG.NPC_KEYWORDS) then return true end
        local ok3, tags2 = pcall(function() return CollectionService:GetTags(child) end)
        if ok3 and tags2 then
            for _, tag in ipairs(tags2) do
                local tl = lowerText(tag)
                for _, kw in ipairs(CFG.NPC_TAGS) do
                    if tl == lowerText(kw) or string.find(tl, lowerText(kw), 1, true) then
                        return true
                    end
                end
            end
        end
        for _, attr in ipairs(CFG.NPC_ATTRS) do
            local ok4, val = pcall(function() return child:GetAttribute(attr) end)
            if ok4 and val ~= nil then return true end
        end
    end
    return false
end

local function isEligibleNpc(model)
    if not model or not model.Parent then return false end
    if Players:GetPlayerFromCharacter(model) then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    local hrp = model:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return false end
    if hum.Health <= 0 then return false end
    if CFG.FilterQuestNpcs then return isQuestOrSpawnNpc(model) end
    return true
end

local function dedupeNpcsByName(npcList)
    if not CFG.DedupeNpcs then return npcList end
    local myPos = Vector3.new(0, 0, 0)
    local char = LP.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then myPos = hrp.Position end
    end
    local byKey = {}
    for _, npc in ipairs(npcList) do
        local hrp = npc:FindFirstChild("HumanoidRootPart")
        if hrp then
            local d = (hrp.Position - myPos).Magnitude
            local key = normalizeNpcName(npc.Name)
            local existing = byKey[key]
            if not existing or d < existing.dist then
                byKey[key] = { npc = npc, dist = d }
            end
        end
    end
    local result = {}
    for _, entry in pairs(byKey) do
        table.insert(result, entry.npc)
    end
    return result
end

