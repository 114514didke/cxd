            FunState.React.token = FunState.React.token + 1
            FunState.React.mode  = "done"
            area.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
            area.Text             = "❌ 太早了！点击重来"
            pcall(function() sLose:Play() end)
            task.delay(1.2, function()
                if FunState.React.mode == "done" then setIdle() end
            end)
        elseif mode == "ready" then
            local ms = (tick() - FunState.React.readyAt) * 1000
            FunState.React.mode = "done"
            local grade
            if ms < 200 then grade = "⚡ 神级反应"
            elseif ms < 280 then grade = "✨ 非常快"
            elseif ms < 380 then grade = "👍 还不错"
            else grade = "😅 再接再厉" end
            area.BackgroundColor3 = Color3.fromRGB(30, 80, 160)
            area.Text = string.format("%.0f ms  %s", ms, grade)
            pcall(function() sWin:Play() end)
