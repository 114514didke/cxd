            setToggleState("PE", true); setToggleState("NE", true); return "ESP ON"
        end
    end
    return "没听懂「" .. raw .. "」～ 输入「帮助」"
end

local httpFn, httpName = nil, "NONE"
if syn and syn.request then httpFn = syn.request; httpName = "syn.request"
elseif http and http.request then httpFn = http.request; httpName = "http.request"
elseif request then httpFn = request; httpName = "request"
elseif http_request then httpFn = http_request; httpName = "http_request" end
print("◆ [Sigma Hub v7.2] HTTP: " .. httpName)

local aiHist = {}

local function callAI(msg)
    if not httpFn then return nil, "执行器不支持 HTTP" end
    if not AI.API_KEY or AI.API_KEY == "" or AI.API_KEY == "在这里填入你的新API-Key" then
        return nil, "未配置 API Key"
    end
    local msgs = { { role="system", content=AI.PROMPT } }
    for _, m in ipairs(aiHist) do table.insert(msgs, m) end
    table.insert(msgs, { role="user", content=msg })

    local ok1, body = pcall(function()
        return HS:JSONEncode({ model=AI.MODEL, messages=msgs, temperature=0.7, max_tokens=500 })
    end)
    if not ok1 then return nil, "编码失败" end

    local ok2, resp = pcall(function()
        return httpFn({
            Url = AI.API_URL, Method = "POST",
            Headers = { ["Content-Type"]="application/json",
                        ["Authorization"]="Bearer "..AI.API_KEY },
            Body = body,
        })
    end)
    if not ok2 then return nil, "请求失败" end
    if not resp or not resp.Body or resp.Body == "" then return nil, "响应为空" end

    local ok3, data = pcall(function() return HS:JSONDecode(resp.Body) end)
    if not ok3 then return nil, "解析失败" end

    if data.choices and data.choices[1] and data.choices[1].message then
        local r = data.choices[1].message.content
        table.insert(aiHist, { role="user", content=msg })
        table.insert(aiHist, { role="assistant", content=r })
        while #aiHist > AI.MAX_HISTORY * 2 do table.remove(aiHist, 1) end
        return r
    end
    if data.error and data.error.message then return nil, "API: "..data.error.message end
    return nil, "未知响应"
end

local function aiRespond(raw)
    local kws = {"帮助","help","清空","clear","状态","status","传送","查玩家",
                 "开技能","关技能","开卖鱼","关卖鱼","开买饵","关买饵","开鱼饵","关鱼饵",
                 "开esp","关esp"}
    local lower = string.lower(raw)
    for _, kw in ipairs(kws) do
        if string.find(lower, string.lower(kw), 1, true) then
            return aiLocal(raw)
        end
    end
    local r, err = callAI(raw)
    if r then return r end
    if AI.FALLBACK then return aiLocal(raw) .. "\n\n[!] " .. (err or "?") end
    return "AI 不可用：" .. (err or "?")
end

