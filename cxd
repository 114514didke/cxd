        result.TextColor3 = Color3.fromRGB(180, 200, 220)
        box.Text = ""
    end

    local function submit()
        if FunState.Guess.done then return end
        local n = tonumber(box.Text)
        if not n or n < 1 or n > 100 then
            result.Text = "请输入 1 - 100 之间的整数"
            result.TextColor3 = Color3.fromRGB(255, 150, 100)
            return
        end
        FunState.Guess.tries = FunState.Guess.tries + 1
        local diff = n - FunState.Guess.target
        if diff == 0 then
            FunState.Guess.done = true
            result.Text = "🎉 猜对了！用了 " .. FunState.Guess.tries .. " 次"
            result.TextColor3 = Color3.fromRGB(0, 255, 130)
            pcall(function() sWin:Play() end)
        elseif math.abs(diff) <= 5 then
            result.Text = (diff > 0 and "🔥 很接近了，往小猜" or "🔥 很接近了，往大猜")
                .. "（第 " .. FunState.Guess.tries .. " 次）"
            result.TextColor3 = Color3.fromRGB(255, 200, 80)
        else
            result.Text = (diff > 0 and "⬇ 太大了" or "⬆ 太小了")
                .. "（第 " .. FunState.Guess.tries .. " 次）"
            result.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
        box.Text = ""
    end

    goBtn.MouseButton1Click:Connect(function() pcall(function() sClick:Play() end); submit() end)
    box.FocusLost:Connect(function(enter) if enter then submit() end end)
    restart.MouseButton1Click:Connect(function() pcall(function() sClick:Play() end); reset() end)
end

